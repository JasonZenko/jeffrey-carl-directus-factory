.TPquote, .TPquote-bottom {
  width: 140px;
  margin:0 auto;
  padding: 10px;
  background-color: #E36966;
  color: #fbc9af;
  text-align: center;
  -webkit-border-radius: 100%;
  -moz-border-radius: 100%;
  border-radius: 100%;
}

.TPquote {
  margin-top: -110px;
}

.TPquote-bottom {
  margin-bottom: -120px;
  z-index: 8;
  position: relative;
}

.TPquote svg, .TPquote-bottom svg {
  width: 60%;
}

.TPquote-bottom svg {
  -webkit-transform: scaleX(-1);
  transform: scaleX(-1);
}

