---
interface Props {
  label: string;
  url: string;
  tone?: 'default' | 'light';
}

const { label, url, tone = 'default' } = Astro.props;
---

<a class:list={['pearl-button', `pearl-button--${tone}`]} href={url}>{label}</a>

<style>
  .pearl-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 24px;
    padding: 11px 20px;
    border: 0;
    border-radius: var(--pearl-button-radius);
    background: var(--pearl-primary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease-out, color 180ms ease-out;
  }

  .pearl-button:hover { background: var(--pearl-accent); color: var(--pearl-ink); }
  .pearl-button--light { border: 1px solid #fff; background: transparent; color: #fff; }
  .pearl-button--light:hover { background: #fff; color: var(--pearl-ink); }

  @media (prefers-reduced-motion: reduce) {
    .pearl-button { transition-duration: .01ms; }
  }
</style>
