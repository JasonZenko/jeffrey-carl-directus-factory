---
interface Props {
  label: string;
  url: string;
  tone?: 'default' | 'light';
}

const { label, url, tone = 'default' } = Astro.props;
---

<a class:list={['pearl-button', `pearl-button--${tone}`]} href={url}>{label}</a>

<style>
  .pearl-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 24px;
    padding: 11px 20px;
    border: 2px solid var(--pearl-forest);
    color: var(--pearl-forest);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease-out, color 180ms ease-out;
  }

  .pearl-button:hover { background: var(--pearl-forest); color: #fff; }
  .pearl-button--light { border-color: #fff; color: #fff; }
  .pearl-button--light:hover { background: #fff; color: var(--pearl-forest-deep); }

  @media (prefers-reduced-motion: reduce) {
    .pearl-button { transition-duration: .01ms; }
  }
</style>
