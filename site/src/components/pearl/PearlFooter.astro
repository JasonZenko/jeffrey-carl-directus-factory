---
import type { PearlTheme } from '../../lib/pearl/theme';
import type { PearlNavigationItem } from '../../lib/pearl/directus';

interface Props { theme: PearlTheme; navigation: PearlNavigationItem[]; logo?: string; }
const { theme, navigation, logo } = Astro.props;
const mapEmbedUrl = theme.address
  ? `https://www.google.com/maps?q=${encodeURIComponent(theme.address)}&output=embed`
  : undefined;
---

<footer id="contact" class="pearl-site-footer">
  {mapEmbedUrl && (
    <div class="pearl-site-footer__map">
      <iframe
        src={mapEmbedUrl}
        title={`Map showing ${theme.brand_name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  )}
  <div class="pearl-wrap pearl-site-footer__grid">
    <div class="pearl-footer-brand">
      {logo ? <img src={logo} alt={theme.brand_name} /> : <strong>{theme.brand_name}</strong>}
      {theme.brand_descriptor && <span>{theme.brand_descriptor}</span>}
    </div>
    <div>
      <h2>Contact information</h2>
      {theme.address && <p>{theme.address}</p>}
      {theme.phone && <p><a href={`tel:${theme.phone.replace(/[^+\d]/g, '')}`}>{theme.phone}</a></p>}
      {theme.email && <p><a href={`mailto:${theme.email}`}>{theme.email}</a></p>}
    </div>
    <nav aria-label="Footer navigation">{navigation.map((item) => <a href={item.url}>{item.label}</a>)}</nav>
  </div>
  <div class="pearl-site-footer__legal"><div class="pearl-wrap">Pearl reference template · noindex review</div></div>
</footer>

<style>
  .pearl-site-footer { padding-top: 0; background: var(--pearl-secondary); color: var(--pearl-ink); }
  .pearl-site-footer__map { width: 100%; aspect-ratio: 21 / 6; }
  .pearl-site-footer__map iframe { display: block; width: 100%; height: 100%; border: 0; }
  .pearl-site-footer__grid { display: grid; grid-template-columns: 1.1fr 1fr .6fr; gap: 56px; padding-bottom: calc(80px * var(--pearl-spacing)); padding-top:30px; }
  .pearl-footer-brand strong { display: block; font-family: var(--pearl-font-heading); font-size: 4rem; font-weight: 400; line-height: .9; }
  .pearl-footer-brand img { width: min(240px, 100%); max-height: 120px; object-fit: contain; object-position: left center; }
  .pearl-footer-brand span { display: block; margin-top: 12px; letter-spacing: .22em; text-transform: uppercase; }
  .pearl-site-footer h2 { margin: 0 0 20px; font-family: var(--pearl-font-body); font-size: .82rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .pearl-site-footer p { margin: 0 0 10px; }
  .pearl-site-footer a { color: inherit; text-underline-offset: 3px; }
  .pearl-site-footer nav { display: flex; flex-direction: column; gap: 12px; }
  .pearl-site-footer__legal { padding: 18px 0; background: var(--pearl-surface); font-size: .76rem; }
  @media (max-width: 760px) { .pearl-site-footer__grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
