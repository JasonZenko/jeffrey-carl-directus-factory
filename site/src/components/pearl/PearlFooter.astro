---
import type { PearlTheme } from '../../lib/pearl/theme';
import type { PearlNavigationItem } from '../../lib/pearl/directus';

interface Props { theme: PearlTheme; navigation: PearlNavigationItem[]; logo?: string; slug?: string; }
const { theme, navigation, logo, slug = 'home' } = Astro.props;
const isHomepage = slug === 'home';
const isContactPage = slug === 'contact-us';
const mapEmbedUrl = isContactPage && theme.address
  ? `https://www.google.com/maps?q=${encodeURIComponent(theme.address)}&output=embed`
  : undefined;
---

<footer id="contact" class="pearl-site-footer">
  {!isHomepage && mapEmbedUrl && (
    <div class="pearl-site-footer__map">
      <iframe
        src={mapEmbedUrl}
        title={`Map showing ${theme.brand_name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  )}
  {!isHomepage && <div class="pearl-wrap pearl-site-footer__contact">
    <div class="pearl-footer-brand">
      {logo ? <img src={logo} alt={theme.brand_name} /> : <strong>{theme.brand_name}</strong>}
    </div>
    <div aria-label="Contact links">
      <h2>Contact Information:</h2>
      {theme.address && <p><a href={theme.map_url} target={theme.map_url ? '_blank' : undefined} rel={theme.map_url ? 'noreferrer' : undefined}>{theme.address}</a></p>}
      {theme.phone && <p><a href={`tel:${theme.phone.replace(/[^+\d]/g, '')}`}>{theme.phone}</a></p>}
      {theme.email && <p><a href={`mailto:${theme.email}`}>{theme.email}</a></p>}
    </div>
    {theme.office_hours && <div class="pearl-footer-hours">
      <h2>Hours:</h2>
      <p>{theme.office_hours.split('\n').map((line) => <>{line}<br /></>)}</p>
    </div>}
    {theme.google_url && <div class="pearl-footer-social">
      <h2>Follow Us:</h2>
      <a href={theme.google_url} target="_blank" rel="noreferrer" aria-label={`${theme.brand_name} on Google`}>
        <svg viewBox="0 0 34.4 35" aria-hidden="true"><path d="M34.4 18c0 10-6.8 17-16.9 17a17.5 17.5 0 1 1 0-35 16.8 16.8 0 0 1 11.7 4.6l-4.8 4.6c-6.2-6-17.8-1.5-17.8 8.3a11 11 0 0 0 10.9 11c7 0 9.5-5 10-7.5h-10v-6H34a15.4 15.4 0 0 1 .3 3Z" /></svg>
      </a>
    </div>}
    <nav class="pearl-footer-navigation" aria-label="Footer navigation">{navigation.map((item) => <a href={item.url}>{item.label}</a>)}</nav>
  </div>}
  <div class="pearl-site-footer__legal">
    <div class="pearl-wrap">
      Copyright © 2010-2026 {theme.brand_name}. All rights reserved. <a href="/sitemap/">Sitemap</a>
    </div>
  </div>
</footer>

<style>
  .pearl-site-footer { padding-top: 0; background: #fbc9af; color: var(--pearl-accent); }
  .pearl-site-footer__map { width: 100%; aspect-ratio: 21 / 7; background: var(--pearl-secondary); }
  .pearl-site-footer__map iframe { display: block; width: 100%; height: 100%; border: 0; }
  .pearl-site-footer__contact { display: grid; justify-items: center; gap: 20px; padding-block: 50px; text-align: center; }
  .pearl-footer-brand strong { display: block; font-family: var(--pearl-font-heading); font-size: 4rem; font-weight: 400; line-height: .9; }
  .pearl-footer-brand img { width: min(325px, 82vw); max-height: 150px; object-fit: contain; object-position: center; mix-blend-mode: multiply; }
  .pearl-site-footer h2 { margin: 8px 0 14px; color: var(--pearl-accent); font-family: var(--pearl-font-heading); font-size: 25px; font-weight: 700; letter-spacing: .08em; text-transform: none; }
  .pearl-site-footer p { margin: 0; color: var(--pearl-accent); font-size: 22px; font-weight: 500; line-height: 1.45; }
  .pearl-site-footer a { color: inherit; text-underline-offset: 3px; }
  .pearl-footer-social a { display: inline-grid; place-items: center; color: var(--pearl-accent); }
  .pearl-footer-social svg { width: 30px; height: 30px; fill: currentColor; }
  .pearl-footer-navigation { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .pearl-site-footer__legal { padding: 14px 0; background: var(--pearl-accent); color: #fff; font-family: var(--pearl-font-body); font-size: 12px; text-align: center; }
  .pearl-site-footer__legal a { color: #fbc9af; text-decoration: none; }
  .pearl-site-footer__legal a:hover, .pearl-site-footer__legal a:focus { color: #fff; text-decoration: underline; }
  @media (max-width: 760px) {
    .pearl-site-footer__map { aspect-ratio: 1 / .72; }
    .pearl-site-footer__contact { padding-block: 42px; }
    .pearl-site-footer p { font-size: 18px; }
  }
</style>
