---
import type {PearlRecordByBlock,PearlVisualRef} from '../types';import {pearlVisualAttr} from '../../../lib/pearl/visual-editing';type Props=PearlRecordByBlock['contact_info_standard']&{visual?:PearlVisualRef};const{heading,address,phone,email,map_url,visual}=Astro.props;const mapEmbedUrl=address?`https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`:undefined;
---
<section id="contact" class="pearl-section pearl-contact-info" data-pearl-block="contact_info_standard" data-directus={pearlVisualAttr(visual)}><div class="pearl-contact-info__map">{mapEmbedUrl&&<iframe src={mapEmbedUrl} title={`Map showing ${address}`} referrerpolicy="no-referrer-when-downgrade"></iframe>}</div><div class="pearl-contact-info__details"><div class="pearl-wrap pearl-contact-info__grid"><div>{heading&&<h2>{heading}</h2>}<p>{address}</p></div><nav aria-label="Contact links">{map_url&&<a href={map_url}>Get directions <span aria-hidden="true">↗</span></a>}{phone&&<a href={`tel:${phone.replace(/[^\d+]/g,'')}`}>Call {phone}</a>}{email&&<a href={`mailto:${email}`}>{email}</a>}</nav></div></div></section>
<style>.pearl-contact-info{position:relative;padding:0;background:var(--pearl-secondary)}.pearl-contact-info__map{width:100%;height:clamp(360px,48vw,560px);background:var(--pearl-secondary)}.pearl-contact-info__map iframe{display:block;width:100%;height:100%;border:0}.pearl-contact-info__details{padding-block:clamp(34px,5vw,58px);background:var(--pearl-secondary)}.pearl-contact-info__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);align-items:center;gap:clamp(30px,6vw,84px)}.pearl-contact-info h2{text-wrap:balance}.pearl-contact-info p{max-width:40ch}.pearl-contact-info nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px}.pearl-contact-info a{display:inline-flex;align-items:center;min-height:48px;padding:12px 16px;border:1px solid var(--pearl-accent);background:#fff;color:var(--pearl-ink);font-weight:700;text-decoration:none}.pearl-contact-info a:hover{background:var(--pearl-accent);color:#fff}@media(max-width:800px){.pearl-contact-info__map{height:380px}.pearl-contact-info__grid{grid-template-columns:1fr}.pearl-contact-info nav{justify-content:flex-start}}@media(prefers-reduced-motion:reduce){.pearl-contact-info a{transition:none}}</style>
