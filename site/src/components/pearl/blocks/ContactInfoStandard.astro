---
import type {PearlRecordByBlock,PearlVisualRef} from '../types';import {pearlVisualAttr} from '../../../lib/pearl/visual-editing';type Props=PearlRecordByBlock['contact_info_standard']&{visual?:PearlVisualRef};const{heading,address,phone,email,map_url,visual}=Astro.props;
---
<section class="pearl-section pearl-contact-info" data-pearl-block="contact_info_standard" data-directus={pearlVisualAttr(visual)}><div class="pearl-wrap pearl-contact-info__grid"><div>{heading&&<h2>{heading}</h2>}<p>{address}</p></div><nav aria-label="Contact links">{map_url&&<a href={map_url}>Get directions <span aria-hidden="true">↗</span></a>}{phone&&<a href={`tel:${phone.replace(/[^\d+]/g,'')}`}>Call {phone}</a>}{email&&<a href={`mailto:${email}`}>{email}</a>}</nav></div></section>
<style>.pearl-contact-info{position:relative;padding-block:clamp(34px,5vw,62px);background:linear-gradient(120deg,var(--pearl-secondary),color-mix(in srgb,var(--pearl-secondary) 78%,#fff))}.pearl-contact-info__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);align-items:center;gap:clamp(30px,6vw,84px)}.pearl-contact-info nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px}.pearl-contact-info a{padding:14px 16px;border:1px solid var(--pearl-accent);background:rgb(255 255 255/.64);color:var(--pearl-ink);font-weight:700;text-decoration:none}@media(max-width:800px){.pearl-contact-info__grid{grid-template-columns:1fr}.pearl-contact-info nav{justify-content:flex-start}}</style>
