---
import type { PearlRecordByBlock, PearlVisualRef } from '../types';
import { pearlVisualAttr } from '../../../lib/pearl/visual-editing';

type Props = PearlRecordByBlock['contact_info_standard'] & { visual?: PearlVisualRef };
const { heading, address, phone, email, map_url, visual } = Astro.props;
---

<section id="contact" class="pearl-section pearl-contact-info" data-pearl-block="contact_info_standard" data-directus={pearlVisualAttr(visual)}>
  <div class="pearl-contact-info__details">
    <div class="pearl-wrap pearl-contact-info__grid">
      <div>
        <h2>Location:</h2>
        <p>{address}</p>
      </div>
      <div class="pearl-contact-info__contact">
        {heading && <h2>{heading}</h2>}
        <nav aria-label="Contact links">
        {map_url && <a href={map_url}>Get directions <span aria-hidden="true">↗</span></a>}
        {phone && <a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>Phone: {phone}</a>}
        {email && <a href={`mailto:${email}`}>Email: {email}</a>}
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  .pearl-contact-info { position: relative; padding: 0; background: var(--pearl-secondary); }
  .pearl-contact-info__details { padding-block: 60px; background: #fff; }
  .pearl-contact-info__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: clamp(30px, 6vw, 84px); }
  .pearl-contact-info h2 { text-wrap: balance; }
  .pearl-contact-info p { max-width: 40ch; }
  .pearl-contact-info h2 { color: var(--pearl-accent); font-family: var(--pearl-font-heading); font-size: 30px; font-weight: 700; line-height: 1.35; }
  .pearl-contact-info nav { display: grid; justify-items: start; gap: 8px; }
  .pearl-contact-info__contact h2 { text-align: left; }
  .pearl-contact-info a { color: var(--pearl-primary); font-weight: 500; text-decoration: none; }
  .pearl-contact-info a:hover { color: var(--pearl-accent); text-decoration: underline; }
  @media (max-width: 800px) {
    .pearl-contact-info__grid { grid-template-columns: 1fr; }
    .pearl-contact-info nav { justify-content: flex-start; }
    .pearl-contact-info__contact h2 { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pearl-contact-info a { transition: none; }
  }
</style>
