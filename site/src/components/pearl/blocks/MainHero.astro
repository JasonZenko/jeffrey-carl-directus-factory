---
import Button from '../ui/Button.astro';
import type { PearlRecordByBlock } from '../types';

type Props = PearlRecordByBlock['main_hero'];
const {
  heading,
  supporting_text,
  background_image,
  background_video_url,
  primary_cta_label,
  primary_cta_url,
} = Astro.props;
---

<section class="pearl-main-hero" data-pearl-block="main_hero" data-background-video-url={background_video_url}>
  {background_image && <img class="pearl-main-hero__image" src={background_image} alt="" />}
  <div class="pearl-main-hero__veil"></div>
  <div class="pearl-wrap pearl-main-hero__content">
    <h1>{heading}</h1>
    {supporting_text && <p>{supporting_text}</p>}
    {primary_cta_label && primary_cta_url && <Button label={primary_cta_label} url={primary_cta_url} tone="light" />}
  </div>
</section>

<style>
  .pearl-main-hero { position: relative; min-height: min(620px, 70vh); display: grid; place-items: center; overflow: hidden; background: var(--pearl-secondary); color: var(--pearl-ink); text-align: center; }
  .pearl-main-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pearl-main-hero__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(255 255 255 / .2), rgb(225 233 243 / .58)); }
  .pearl-main-hero__content { position: relative; z-index: 1; display: grid; justify-items: center; padding-block: clamp(6rem, 12vw, 10rem); }
  .pearl-main-hero__content h1 { max-width: 16ch; color: var(--pearl-ink); text-transform: uppercase; }
  .pearl-main-hero__content p { max-width: 34ch; margin: 8px 0 0; font-family: var(--pearl-font-heading); font-size: clamp(1.25rem, 2vw, 1.65rem); }

  @media (max-width: 800px) {
    .pearl-main-hero { min-height: 540px; }
  }
</style>
