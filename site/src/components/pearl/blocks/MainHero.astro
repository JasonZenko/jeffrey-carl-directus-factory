---
import Button from '../ui/Button.astro';
import type { PearlRecordByBlock } from '../types';

type Props = PearlRecordByBlock['main_hero'];
const {
  heading,
  supporting_text,
  background_image,
  background_video_url,
  primary_cta_label,
  primary_cta_url,
} = Astro.props;
---

<section class="pearl-main-hero" data-pearl-block="main_hero" data-background-video-url={background_video_url}>
  {background_image && <img class="pearl-main-hero__image" src={background_image} alt="" />}
  <div class="pearl-main-hero__veil"></div>
  <div class="pearl-wrap pearl-main-hero__content">
    <h1>{heading}</h1>
    {supporting_text && <p>{supporting_text}</p>}
    {primary_cta_label && primary_cta_url && <Button label={primary_cta_label} url={primary_cta_url} tone="light" />}
  </div>
</section>

<style>
  .pearl-main-hero { position: relative; min-height: min(760px, 82vh); display: grid; align-items: end; overflow: hidden; background: var(--pearl-forest-deep); color: #fff; }
  .pearl-main-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pearl-main-hero__veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(25 38 28 / .88) 0%, rgb(25 38 28 / .58) 54%, rgb(25 38 28 / .18) 100%); }
  .pearl-main-hero__content { position: relative; z-index: 1; padding-block: clamp(5rem, 10vw, 9rem); }
  .pearl-main-hero__content h1 { max-width: 11ch; color: #fff; }
  .pearl-main-hero__content p { max-width: 32ch; margin: 20px 0 0; font-size: clamp(1.2rem, 2vw, 1.55rem); }

  @media (max-width: 800px) {
    .pearl-main-hero { min-height: 680px; }
    .pearl-main-hero__veil { background: linear-gradient(0deg, rgb(25 38 28 / .94), rgb(25 38 28 / .22)); }
  }
</style>
