---
import type {PearlRecordByBlock, PearlVisualRef} from '../types';
import {pearlVisualAttr} from '../../../lib/pearl/visual-editing';
type Props=PearlRecordByBlock['highlight_snippet_quote'] & {visual?:PearlVisualRef};
const {quote,attribution,tone,facebook_url,x_url,visual}=Astro.props;
---
<section class:list={['pearl-section','pearl-snippet-quote',`pearl-snippet-quote--${tone}`]} data-pearl-block="highlight_snippet_quote" data-directus={pearlVisualAttr(visual)}><span class="pearl-snippet-quote__mark pearl-snippet-quote__mark--open" aria-hidden="true">“</span><div class="pearl-wrap"><blockquote set:html={quote}/>{attribution&&<cite>{attribution}</cite>}{(facebook_url||x_url)&&<nav aria-label="Social media">{facebook_url&&<a href={facebook_url} aria-label="Facebook">f</a>}{x_url&&<a href={x_url} aria-label="X">X</a>}</nav>}</div><span class="pearl-snippet-quote__mark pearl-snippet-quote__mark--close" aria-hidden="true">”</span></section>
<style>
  .pearl-snippet-quote{position:relative;z-index:3;isolation:isolate;padding-block:clamp(112px,12vw,154px);text-align:center;overflow:visible}.pearl-snippet-quote--brand,.pearl-snippet-quote--dark{background:var(--pearl-primary);color:#fff}.pearl-snippet-quote--light{background:var(--pearl-secondary);color:var(--pearl-ink)}.pearl-snippet-quote blockquote{max-width:75ch;margin:0 auto;font-size:clamp(1rem,1.45vw,1.2rem);line-height:1.7}.pearl-snippet-quote blockquote :global(p){margin:0}.pearl-snippet-quote cite{display:block;margin-top:24px}.pearl-snippet-quote__mark{position:absolute;z-index:2;left:50%;display:grid;place-items:center;width:84px;height:84px;border-radius:50%;background:var(--pearl-primary);color:#fff;font-family:Georgia,serif;font-size:5rem;line-height:1;transform:translateX(-50%)}.pearl-snippet-quote__mark--open{top:0;padding-top:27px;box-shadow:0 0 0 2px rgb(255 255 255/.86);transform:translate(-50%,-50%)}.pearl-snippet-quote__mark--close{bottom:0;padding-top:10px;transform:translate(-50%,50%)}.pearl-snippet-quote nav{display:flex;justify-content:center;gap:10px;margin-top:28px}.pearl-snippet-quote nav a{display:grid;place-items:center;width:30px;height:30px;background:#fff;color:var(--pearl-primary);font-family:Arial,sans-serif;font-weight:700;text-decoration:none}
</style>
