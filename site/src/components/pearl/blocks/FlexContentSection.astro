---
import type { PearlRecordByBlock, PearlVisualRef } from '../types';
import { pearlVisualAttr } from '../../../lib/pearl/visual-editing';

type Props = PearlRecordByBlock['flex_content_section'] & { visual?: PearlVisualRef };
const { section_header, body_content, image, image_alt, image_position = 'right', header_tag = 'h2', visual } = Astro.props;
const Heading = header_tag;
---

<section class="pearl-section pearl-flex-standard" data-pearl-block="flex_content_section" data-directus={pearlVisualAttr(visual)}>
  <div class="pearl-wrap">
    {section_header && <Heading>{section_header}</Heading>}
    <div class="pearl-flex-standard__body">
      {image && (
        <img
          class:list={['pearl-flex-standard__image', `pearl-flex-standard__image--${image_position}`]}
          src={image}
          alt={image_alt ?? ''}
        />
      )}
      <div class="pearl-prose" set:html={body_content} />
    </div>
  </div>
</section>

<style>
  
.pearl-flex-standard + .pearl-flex-standard {
  padding-top: 0;
}
  .pearl-flex-standard h2 { margin-bottom: 20px; }

  .pearl-flex-standard__body { overflow: auto; }

  .pearl-flex-standard__image {
    display: block;
    width: 33%;
    height: auto;
    margin-bottom: 16px;
    shape-margin: 12px;
  }

  .pearl-flex-standard__image--left { float: left; margin-right: 24px; }
  .pearl-flex-standard__image--right { float: right; margin-left: 24px; }

  @media (max-width: 800px) {
    .pearl-flex-standard__image { float: none; width: 100%; margin: 0 0 20px; }
  }
</style>
