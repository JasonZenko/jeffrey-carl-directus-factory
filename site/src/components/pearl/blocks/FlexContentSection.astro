---
import type { PearlRecordByBlock, PearlVisualRef } from '../types';
import { pearlVisualAttr } from '../../../lib/pearl/visual-editing';

type Props = PearlRecordByBlock['flex_content_section'] & { visual?: PearlVisualRef };
const { section_header, body_content, image, image_alt, image_position = 'right', header_tag = 'h2', visual } = Astro.props;
const Heading = header_tag;
const isDoctorsHeading = section_header?.trim().toLowerCase() === 'meet the doctors';
const isDoctorProfile = Boolean(image && /More About Dr\./i.test(body_content));
---

<section
  class:list={[
    'pearl-section',
    'pearl-flex-standard',
    { 'pearl-flex-standard--doctors-heading': isDoctorsHeading },
    { 'pearl-flex-standard--doctor-profile': isDoctorProfile },
  ]}
  data-pearl-block="flex_content_section"
  data-directus={pearlVisualAttr(visual)}
>
  <div class="pearl-wrap">
    {section_header && !isDoctorProfile && <Heading>{section_header}</Heading>}
    <div class="pearl-flex-standard__body">
      {image && (
        <img
          class:list={['pearl-flex-standard__image', `pearl-flex-standard__image--${image_position}`]}
          src={image}
          alt={image_alt ?? ''}
        />
      )}
      {isDoctorProfile ? (
        <div class="pearl-prose">
          {section_header && <Heading>{section_header}</Heading>}
          <div set:html={body_content} />
        </div>
      ) : (
        <div class="pearl-prose" set:html={body_content} />
      )}
    </div>
  </div>
</section>

<script>
  const doctorProfiles = document.querySelectorAll('.pearl-flex-standard--doctor-profile');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducedMotion || !('IntersectionObserver' in window)) {
    doctorProfiles.forEach((profile) => profile.classList.add('pearl-flex-standard--visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('pearl-flex-standard--visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.18 });

    doctorProfiles.forEach((profile) => observer.observe(profile));
  }
</script>

<style>
  
.pearl-flex-standard + .pearl-flex-standard {
  padding-top: 0;
}
  .pearl-flex-standard h2 { margin-bottom: 20px; }

  .pearl-flex-standard__body { overflow: auto; }

  .pearl-flex-standard__image {
    display: block;
    width: 33%;
    height: auto;
    margin-bottom: 16px;
    shape-margin: 12px;
  }

  .pearl-flex-standard__image--left { float: left; margin-right: 24px; }
  .pearl-flex-standard__image--right { float: right; margin-left: 24px; }

  .pearl-flex-standard--doctors-heading {
    padding-top: clamp(72px, 8vw, 100px);
    padding-bottom: 26px;
    text-align: center;
  }

  .pearl-flex-standard--doctors-heading h2 {
    margin: 0;
    font-family: var(--pearl-font-heading);
    font-size: clamp(2.6rem, 4.2vw, 3.45rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .pearl-flex-standard--doctor-profile { padding-block: 0; }

  .pearl-flex-standard--doctor-profile .pearl-wrap {
    padding-block: clamp(48px, 6vw, 76px);
    border-bottom: 2px solid #9bb5c4;
  }

  .pearl-flex-standard--doctor-profile h3 {
    margin-bottom: 20px;
    font-family: var(--pearl-font-heading);
    font-size: clamp(2rem, 3vw, 2.7rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .pearl-flex-standard--doctor-profile .pearl-flex-standard__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 1fr);
    align-items: center;
    gap: clamp(36px, 7vw, 86px);
    overflow: visible;
  }

  .pearl-flex-standard--doctor-profile .pearl-flex-standard__image {
    float: none;
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    margin: 0;
    border: 5px solid #fff;
  }

  .pearl-flex-standard--doctor-profile .pearl-prose {
    grid-column: 1;
    grid-row: 1;
  }

  .pearl-flex-standard--doctor-profile :global(.paragraph-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 24px;
    padding: 11px 20px;
    border-radius: 0;
    background: var(--pearl-primary);
    color: #fff;
    font-weight: 400;
    line-height: 1.25;
    text-decoration: none;
  }

  .pearl-flex-standard--doctor-profile :global(.paragraph-button:hover) {
    background: color-mix(in srgb, var(--pearl-primary) 82%, #000);
  }

  .pearl-flex-standard--doctor-profile .pearl-prose,
  .pearl-flex-standard--doctor-profile .pearl-flex-standard__image {
    opacity: 0;
    transition: opacity .72s ease, transform .72s cubic-bezier(.22, 1, .36, 1);
  }

  .pearl-flex-standard--doctor-profile .pearl-prose { transform: translateY(22px); }
  .pearl-flex-standard--doctor-profile .pearl-flex-standard__image { transform: translateY(-22px); }

  .pearl-flex-standard--doctor-profile.pearl-flex-standard--visible .pearl-prose,
  .pearl-flex-standard--doctor-profile.pearl-flex-standard--visible .pearl-flex-standard__image {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 800px) {
    .pearl-flex-standard__image { float: none; width: 100%; margin: 0 0 20px; }

    .pearl-flex-standard--doctors-heading { padding-block: 60px 12px; }

    .pearl-flex-standard--doctor-profile .pearl-wrap { padding-block: 42px; }

    .pearl-flex-standard--doctor-profile .pearl-flex-standard__body {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .pearl-flex-standard--doctor-profile .pearl-flex-standard__image,
    .pearl-flex-standard--doctor-profile .pearl-prose { grid-column: 1; }

    .pearl-flex-standard--doctor-profile .pearl-flex-standard__image {
      grid-row: 1;
      margin: 0;
    }

    .pearl-flex-standard--doctor-profile .pearl-prose { grid-row: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pearl-flex-standard--doctor-profile .pearl-prose,
    .pearl-flex-standard--doctor-profile .pearl-flex-standard__image {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
