---
import type {PearlRecordByBlock, PearlVisualRef} from '../types';
import {pearlVisualAttr} from '../../../lib/pearl/visual-editing';
type Props=PearlRecordByBlock['testimonial_list_standard'] & {visual?:PearlVisualRef};
const {section_heading,intro_text,reviews,visual}=Astro.props;const ordered=[...reviews].sort((a,b)=>a.sort-b.sort);
---
<section class="pearl-section pearl-testimonials" data-pearl-block="testimonial_list_standard" data-directus={pearlVisualAttr(visual)}><div class="pearl-wrap">{section_heading&&<h2>{section_heading}</h2>}{intro_text&&<p>{intro_text}</p>}<div class="pearl-testimonials__grid">{ordered.map(review=><figure><blockquote set:html={review.quote}/><figcaption>{review.patient_name&&<strong>{review.patient_name}</strong>}{review.rating&&<span aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>}</figcaption></figure>)}</div></div></section>
<style>
  .pearl-testimonials{background:var(--pearl-secondary)}.pearl-testimonials__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:32px}.pearl-testimonials figure{margin:0;padding:28px;background:#fff}.pearl-testimonials blockquote{margin:0}.pearl-testimonials figcaption{display:flex;justify-content:space-between;gap:20px;margin-top:20px;color:var(--pearl-primary)}
</style>
