---
import type { PearlRecordByBlock, PearlVisualRef } from '../types';
import { pearlVisualAttr } from '../../../lib/pearl/visual-editing';

type Props = PearlRecordByBlock['testimonial_list_standard'] & { visual?: PearlVisualRef };
const { section_heading, intro_text, reviews, visual } = Astro.props;
const ordered = [...reviews].sort((a, b) => a.sort - b.sort);
---

<section class="pearl-section pearl-testimonials" data-pearl-block="testimonial_list_standard" data-directus={pearlVisualAttr(visual)}>
  <div class="pearl-wrap">
    {section_heading && <h2>{section_heading}</h2>}
    {intro_text && <p>{intro_text}</p>}

    <div class="pearl-testimonials__list">
      {ordered.map((review) => (
        <article class="pearl-testimonial">
          <div class="pearl-testimonial__meta">
            {review.patient_name && <p class="pearl-testimonial__name">{review.patient_name}</p>}
            <div class="pearl-testimonial__stars" aria-label="5 out of 5 stars">★★★★★</div>
          </div>
          <blockquote class="pearl-testimonial__quote" set:html={review.quote} />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pearl-testimonials { background: var(--pearl-secondary); }

  .pearl-testimonials__list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-top: 32px;
    max-width: 1000px;
  }

  .pearl-testimonial {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    align-items: start;
    padding: 28px 0;
  
  }

  .pearl-testimonial__meta { display: grid; gap: 10px; }
  .pearl-testimonial__name { margin: 0; font-weight: 700; color: var(--pearl-ink); }
  .pearl-testimonial__stars { color: #f4c542; font-size: 1.1rem; letter-spacing: 3px; }
  .pearl-testimonial__meta {
  padding-right: 24px;
  border-right: 2px solid var(--pearl-primary);
  }

  .pearl-testimonial__quote {
    position: relative;
    margin: 0;
    padding-left: 28px;
    font-style: italic;
    line-height: 1.7;
  }

  .pearl-testimonial__quote::before {
    content: '“';
    position: absolute;
    top: -.15em;
    left: 0;
    font-family: Georgia, serif;
    font-size: 2rem;
    font-style: normal;
    line-height: 1;
    color: var(--pearl-primary);
  }

  @media (max-width: 800px) {
    .pearl-testimonial { grid-template-columns: 1fr; gap: 12px; }
  }
</style>