---
import type { PearlRecordByBlock } from '../types';

type Props = PearlRecordByBlock['areas_served_links'];
const { heading, intro, areas } = Astro.props;
const orderedAreas = [...areas].sort((a, b) => a.sort - b.sort);
---

<section class="pearl-section pearl-areas" data-pearl-block="areas_served_links">
  <div class="pearl-wrap pearl-areas__grid">
    <div><h2>{heading}</h2>{intro && <p>{intro}</p>}</div>
    <nav aria-label={heading}><ul>{orderedAreas.map((area) => <li><a href={area.url}>{area.label}<span aria-hidden="true">↗</span></a></li>)}</ul></nav>
  </div>
</section>

<style>
  .pearl-areas { background: var(--pearl-light); }
  .pearl-areas__grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(50px, 10vw, 140px); }
  .pearl-areas__grid > div p { max-width: 42ch; color: var(--pearl-muted); }
  .pearl-areas ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid #aab2a6; }
  .pearl-areas a { display: flex; justify-content: space-between; gap: 20px; min-height: 58px; align-items: center; border-bottom: 1px solid #aab2a6; color: var(--pearl-ink); font-weight: 700; text-decoration: none; }
  .pearl-areas a:hover { color: var(--pearl-maroon); }

  @media (max-width: 800px) {
    .pearl-areas__grid { grid-template-columns: 1fr; }
  }
</style>
