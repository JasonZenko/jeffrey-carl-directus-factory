---
import Button from '../ui/Button.astro';
import type {PearlRecordByBlock, PearlVisualRef} from '../types';
import {pearlVisualAttr} from '../../../lib/pearl/visual-editing';
type Props = PearlRecordByBlock['inner_hero_standard'] & {visual?: PearlVisualRef};
const {page_title, intro_paragraph, featured_image, image_alt, cta_label, cta_url, visual} = Astro.props;
---
<section class="pearl-section pearl-inner-standard" data-pearl-block="inner_hero_standard" data-directus={pearlVisualAttr(visual)}>
  <div class="pearl-wrap pearl-inner-standard__grid">
    <div><h1>{page_title}</h1>{intro_paragraph && <div class="pearl-prose" set:html={intro_paragraph} />}{cta_label && cta_url && <Button label={cta_label} url={cta_url} />}</div>
    {featured_image && <img src={featured_image} alt={image_alt ?? ''} />}
  </div>
</section>
<style>
  .pearl-inner-standard {padding-block: 50px; background: color-mix(in srgb, var(--pearl-secondary) 84%, var(--pearl-primary));}
  .pearl-inner-standard__grid {display:grid;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);gap:clamp(30px,6vw,80px);align-items:center;}
  .pearl-inner-standard img{width:100%;aspect-ratio:4/3;object-fit:cover;border:5px solid #fff;}
  @media(max-width:800px){.pearl-inner-standard__grid{grid-template-columns:1fr;}}
</style>
