---
import Button from '../ui/Button.astro';
import type { PearlRecordByBlock, PearlVisualRef } from '../types';
import { pearlVisualAttr } from '../../../lib/pearl/visual-editing';

type Props = PearlRecordByBlock['inner_hero_cta'] & { visual?: PearlVisualRef };
const { heading, secondary_heading, body, image, image_alt, cta_label, cta_url, visual } = Astro.props;
---

<section class="pearl-inner-hero" data-pearl-block="inner_hero_cta" data-directus={pearlVisualAttr(visual)}>
  {image && <img src={image} alt={image_alt ?? ''} />}
  <div class="pearl-inner-hero__veil"></div>
  <div class="pearl-wrap pearl-inner-hero__content">
    <h1>{heading}</h1>
    {secondary_heading && <h2>{secondary_heading}</h2>}
    {body && <div class="pearl-prose" set:html={body} />}
    {cta_label && cta_url && <Button label={cta_label} url={cta_url} tone="light" />}
  </div>
</section>

<style>
  .pearl-inner-hero { position: relative; min-height: 620px; display: grid; align-items: end; overflow: hidden; background: var(--pearl-accent); color: #fff; }
  .pearl-inner-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pearl-inner-hero__veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(17 17 17 / .84), rgb(17 17 17 / .18)); }
  .pearl-inner-hero__content { position: relative; z-index: 1; padding-block: 80px; }
  .pearl-inner-hero h1 { max-width: 12ch; color: #fff; }
  .pearl-inner-hero h2 { max-width: 18ch; margin-top: 14px; color: #fff; font-family: var(--pearl-font-body); font-size: clamp(1.25rem, 2.4vw, 1.8rem); font-weight: 500; }

  @media (max-width: 800px) {
    .pearl-inner-hero__veil { background: linear-gradient(0deg, rgb(25 38 28 / .94), rgb(25 38 28 / .22)); }
  }

  @media (max-width: 480px) {
    .pearl-inner-hero { min-height: 560px; }
  }
</style>
