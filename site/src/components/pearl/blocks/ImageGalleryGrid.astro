---
import type {PearlRecordByBlock, PearlVisualRef} from '../types';
import {pearlVisualAttr} from '../../../lib/pearl/visual-editing';
type Props = PearlRecordByBlock['image_gallery_grid'] & {visual?: PearlVisualRef};
const {section_heading, grid_columns, images, visual} = Astro.props;
const ordered=[...images].sort((a,b)=>a.sort-b.sort);
---
<section class="pearl-section pearl-gallery" data-pearl-block="image_gallery_grid" data-directus={pearlVisualAttr(visual)} style={`--pearl-gallery-columns:${grid_columns}`}><div class="pearl-wrap">{section_heading && <h2>{section_heading}</h2>}<div class="pearl-gallery__grid">{ordered.map(item=><img src={item.image} alt={item.image_alt} loading="lazy"/>)}</div></div></section>
<style>
  .pearl-gallery{background:#fff}.pearl-gallery__grid{display:grid;grid-template-columns:repeat(var(--pearl-gallery-columns),minmax(0,1fr));gap:18px;margin-top:30px}.pearl-gallery img{width:100%;aspect-ratio:4/3;object-fit:cover}@media(max-width:800px){.pearl-gallery__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.pearl-gallery__grid{grid-template-columns:1fr}}
</style>
