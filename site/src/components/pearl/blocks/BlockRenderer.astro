---
import type { PearlBlock } from '../types';
import MainHero from './MainHero.astro';
import InnerHeroCta from './InnerHeroCta.astro';
import FlexContentImage from './FlexContentImage.astro';
import SplitImageContent from './SplitImageContent.astro';
import PatientReviews from './PatientReviews.astro';
import AreasServedLinks from './AreasServedLinks.astro';
import IconCircles from './IconCircles.astro';
import HighlightQuote from './HighlightQuote.astro';
import ContentImage from './ContentImage.astro';

interface Props { block: PearlBlock; }
const { block } = Astro.props;
---

{block.type === 'main_hero' && <MainHero {...block.item} visual={block.visual} />}
{block.type === 'inner_hero_cta' && <InnerHeroCta {...block.item} visual={block.visual} />}
{block.type === 'flex_content_image' && <FlexContentImage {...block.item} visual={block.visual} />}
{block.type === 'split_image_content' && <SplitImageContent {...block.item} visual={block.visual} />}
{block.type === 'patient_reviews' && <PatientReviews {...block.item} visual={block.visual} />}
{block.type === 'areas_served_links' && <AreasServedLinks {...block.item} visual={block.visual} />}
{block.type === 'icon_circles' && <IconCircles {...block.item} visual={block.visual} />}
{block.type === 'highlight_quote' && <HighlightQuote {...block.item} visual={block.visual} />}
{block.type === 'content_image' && <ContentImage {...block.item} visual={block.visual} />}
