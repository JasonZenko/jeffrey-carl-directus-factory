---
import type { PearlRecordByBlock } from '../types';

type Props = PearlRecordByBlock['icon_circles'];
const { heading, intro, items } = Astro.props;
const orderedItems = [...items].sort((a, b) => a.sort - b.sort);
---

<section id="services" class="pearl-section pearl-icons" data-pearl-block="icon_circles">
  <div class="pearl-wrap">
    <div class="pearl-heading-row">{heading && <h2>{heading}</h2>}{intro && <p>{intro}</p>}</div>
    <ul class="pearl-icons__list">
      {orderedItems.map((item) => <li><span class="pearl-icons__mark" aria-hidden="true">{item.icon.startsWith('http') ? <img src={item.icon} alt="" /> : item.icon}</span><h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title}</h3>{item.body && <p>{item.body}</p>}</li>)}
    </ul>
  </div>
</section>

<style>
  .pearl-icons { position: relative; z-index: 2; margin-top: -78px; padding-top: 0; background: var(--pearl-secondary); }
  .pearl-heading-row { display: flex; justify-content: center; gap: 40px; align-items: end; margin-bottom: 48px; text-align: center; }
  .pearl-heading-row > p { max-width: 48ch; margin: 0; color: var(--pearl-muted); }
  .pearl-icons__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 3vw, 40px); margin: 0; padding: 0; list-style: none; }
  .pearl-icons__list li { text-align: center; }
  .pearl-icons__mark { display: grid; place-items: center; width: clamp(132px, 17vw, 210px); aspect-ratio: 1; margin: 0 auto 22px; border: 6px double rgb(255 255 255 / .78); border-radius: 50%; background: var(--pearl-circle); color: #fff; font-family: var(--pearl-font-heading); font-size: 2.4rem; }
  .pearl-icons__mark img { width: 100%; height: 100%; object-fit: contain; }
  .pearl-icons h3 { max-width: 14ch; margin-inline: auto; font-family: var(--pearl-font-body); font-size: 1rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .pearl-icons a { color: var(--pearl-ink); text-decoration: none; }
  .pearl-icons a:hover { color: var(--pearl-primary); text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 800px) {
    .pearl-icons { margin-top: -48px; }
    .pearl-heading-row { align-items: flex-start; flex-direction: column; }
    .pearl-icons__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .pearl-icons__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 38px 14px; }
    .pearl-icons__mark { width: min(38vw, 148px); }
  }
</style>
