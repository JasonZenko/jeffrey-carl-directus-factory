---
import type { PearlImage, PearlLink } from './types';
interface Props { heading: string; supportingText?: string; backgroundImage?: PearlImage; primaryCta?: PearlLink; }
const { heading, supportingText, backgroundImage, primaryCta } = Astro.props;
---
<section class="pearl-main-hero" style={backgroundImage ? `--pearl-hero: url('${backgroundImage.src}')` : undefined} data-pearl-block="main_hero">
  {backgroundImage && <img class="pearl-main-hero__image" src={backgroundImage.src} alt={backgroundImage.alt} />}
  <div class="pearl-main-hero__veil"></div>
  <div class="pearl-wrap pearl-main-hero__content">
    <h1>{heading}</h1>
    {supportingText && <p>{supportingText}</p>}
    {primaryCta && <a class="pearl-action pearl-action--light" href={primaryCta.url}>{primaryCta.label}</a>}
  </div>
</section>
