---
import type { PearlImage } from './types';
interface Props { heading?: string; body: string; image: PearlImage; imagePosition: 'left' | 'right'; imageWidth: 'half' | 'wide'; backgroundTone: 'white' | 'light' | 'brand'; }
const { heading, body, image, imagePosition, imageWidth, backgroundTone } = Astro.props;
---
<section class:list={['pearl-split', `pearl-split--${imagePosition}`, `pearl-split--${imageWidth}`, `pearl-split--${backgroundTone}`]} data-pearl-block="split_image_content">
  <div class="pearl-split__media"><img src={image.src} alt={image.alt} loading="lazy" /></div>
  <div class="pearl-split__copy">
    {heading && <h2>{heading}</h2>}
    <div class="pearl-prose" set:html={body} />
  </div>
</section>
