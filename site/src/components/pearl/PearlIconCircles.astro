---
import type { PearlIconItem } from './types';
interface Props { heading?: string; intro?: string; items: PearlIconItem[]; }
const { heading, intro, items } = Astro.props;
---
<section class="pearl-section pearl-icons" data-pearl-block="icon_circles">
  <div class="pearl-wrap">
    <div class="pearl-heading-row">{heading && <h2>{heading}</h2>}{intro && <p>{intro}</p>}</div>
    <ul class="pearl-icons__list">
      {items.map((item) => <li><span class="pearl-icons__mark" aria-hidden="true">{item.icon}</span><h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title}</h3>{item.body && <p>{item.body}</p>}</li>)}
    </ul>
  </div>
</section>
