---
import type { PearlImage, PearlLink } from './types';
interface Props { heading?: string; body: string; image: PearlImage; imagePosition: 'left' | 'right'; cta?: PearlLink; }
const { heading, body, image, imagePosition, cta } = Astro.props;
---
<section class:list={['pearl-section', 'pearl-flex', `pearl-flex--${imagePosition}`]} data-pearl-block="flex_content_image">
  <div class="pearl-wrap pearl-flex__grid">
    <figure><img src={image.src} alt={image.alt} loading="lazy" /></figure>
    <div class="pearl-flex__content">
      {heading && <h2>{heading}</h2>}
      <div class="pearl-prose" set:html={body} />
      {cta && <a class="pearl-action" href={cta.url}>{cta.label}</a>}
    </div>
  </div>
</section>
