---
import type { PearlImage, PearlLink } from './types';
interface Props { heading: string; secondaryHeading?: string; body?: string; image?: PearlImage; cta?: PearlLink; }
const { heading, secondaryHeading, body, image, cta } = Astro.props;
---
<section class="pearl-inner-hero" data-pearl-block="inner_hero_cta">
  {image && <img src={image.src} alt={image.alt} />}
  <div class="pearl-inner-hero__veil"></div>
  <div class="pearl-wrap pearl-inner-hero__content">
    <h1>{heading}</h1>
    {secondaryHeading && <h2>{secondaryHeading}</h2>}
    {body && <div class="pearl-prose" set:html={body} />}
    {cta && <a class="pearl-action pearl-action--light" href={cta.url}>{cta.label}</a>}
  </div>
</section>
