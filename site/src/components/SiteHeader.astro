---
import type { SiteRecord } from '../lib/contracts';

interface Props {
  site: SiteRecord;
}

const { site } = Astro.props;
const facebook = site.footer.links.find((link) => /facebook/i.test(link.label));
const map = site.footer.links.find((link) => /3120 Pacific/i.test(link.label));
---

<header class="site-header" data-review-chrome>
  <div class="site-header__mobile-actions" aria-label="Quick actions">
    <a href={site.phone_href} aria-label={`Call ${site.phone}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.7 15.7 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.56 3.6.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.56 3.58a1 1 0 0 1-.25 1.02L6.6 10.8Z"/></svg>
      <span>{site.phone}</span>
    </a>
    <a href={map?.href || '#'} target={map?.target || undefined} aria-label="Open map">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
      <span>Albany, OR</span>
    </a>
    <a href={site.appointment_path} aria-label="Request an appointment">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2Zm13 8H4v10h16V10Zm-2-4H6v2h12V6Zm-7.2 11.2 5-5 1.4 1.4-6.4 6.4-3.5-3.5 1.4-1.4 2.1 2.1Z"/></svg>
      <span>Request An Appointment</span>
    </a>
  </div>
  <div class="site-header__inner" style={site.inner_hero_image ? `--inner-header-image: url('${site.inner_hero_image}')` : undefined}>
    <a class="site-header__brand" href={site.homepage.legacy_path} aria-label={`${site.name} home`}>
      {site.logo ? <img src={site.logo} alt={site.name} /> : <span>{site.name}</span>}
    </a>
    <div class="site-header__desktop-contact">
      <div class="site-header__top-actions">
        {site.appointment_path && (
          <a class="site-header__appointment" href={site.appointment_path}>
            <svg class="site-header__calendar" viewBox="0 0 95.9 106.4" fill="none" stroke="currentColor" aria-hidden="true">
              <path d="M84.9 14.1h-9.6v5c0 3.5-2.9 6.4-6.5 6.4a6.5 6.5 0 0 1-6.5-6.4v-5H33.6v5c0 3.5-2.8 6.4-6.4 6.4h-.1a6.5 6.5 0 0 1-6.5-6.4v-5H11A7.8 7.8 0 0 0 3.3 22v73.4c0 4.3 3.5 7.8 7.9 7.8h73.8c4.3 0 7.8-3.5 7.8-7.8V22c0-4.3-3.5-7.9-7.8-7.9Z" />
              <rect x="20.6" y="3.2" width="13" height="22.3" rx="6.5" />
              <rect x="62.3" y="3.2" width="13" height="22.3" rx="6.5" />
              <path d="M3.2 37.2h89.5M30 67.3l12.8 12.9h.5L68 55.6" />
            </svg>
            <span>Request an appointment</span>
          </a>
        )}
        {facebook && <a class="site-header__social" href={facebook.href} target={facebook.target || undefined} aria-label="Facebook">f</a>}
        {map && <a class="site-header__social" href={map.href} target={map.target || undefined} aria-label="Google business profile">G</a>}
      </div>
      {site.address && (
        <a class="site-header__address" href={map?.href || '#'} target={map?.target || undefined}>
          <svg viewBox="0 0 16 22" aria-hidden="true"><path d="M8 0a8.1 8.1 0 0 0-8 8.2C0 13.6 8 22 8 22s8-8.4 8-13.7A8.1 8.1 0 0 0 8 0Zm0 12a3.8 3.8 0 1 1 3.7-3.8A3.8 3.8 0 0 1 8 12.1Z" /></svg>
          <span>{site.address}</span>
        </a>
      )}
      {site.phone && (
        <a class="site-header__phone" href={site.phone_href}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.7 15.7 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.56 3.6.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.56 3.58a1 1 0 0 1-.25 1.02L6.6 10.8Z"/></svg>
          {site.phone}
        </a>
      )}
    </div>
  </div>
  <div class="site-nav-wrap">
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {site.navigation.map((item) => (
          <li class:list={{ 'site-nav__item': true, 'site-nav__item--has-children': item.children?.length }}>
            <a href={item.href || '#'} target={item.target || undefined}>
              <span>{item.label || item.href}</span>
              {item.children?.length && <span class="site-nav__chevron" aria-hidden="true">⌄</span>}
            </a>
            {item.children?.length && (
              <ul class="site-nav__submenu" aria-label={`${item.label} submenu`}>
                {item.children.map((child) => (
                  <li><a href={child.href || '#'} target={child.target || undefined}>{child.label || child.href}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <details class="mobile-nav">
      <summary><span aria-hidden="true">☰</span><span class="sr-only">Open menu</span></summary>
      <nav aria-label="Mobile primary">
        <ul>
          {site.navigation.map((item) => (
            <li>
              {item.children?.length ? (
                <details class="mobile-nav__group">
                  <summary>{item.label}</summary>
                  <ul>
                    <li><a href={item.href || '#'} target={item.target || undefined}>{item.label} overview</a></li>
                    {item.children.map((child) => (
                      <li><a href={child.href || '#'} target={child.target || undefined}>{child.label || child.href}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href || '#'} target={item.target || undefined}>{item.label || item.href}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
