---
import type { PageRecord, SiteRecord } from '../lib/contracts';

interface Props {
  site: SiteRecord;
  page: PageRecord;
}

const { site, page } = Astro.props;
const email = site.footer.links.find((link) => /^mailto:/i.test(link.href));
const facebook = site.footer.links.find((link) => /facebook/i.test(link.label));
const google = site.footer.links.find((link) => /google/i.test(link.label));
const copyrightLine = site.footer.copyright.match(/^.*?\bSitemap\b/)?.[0] ?? site.footer.copyright;
const addressParts = site.address.match(/^(.*?SW),?\s+(Albany,\s*OR\s+\d{5})/i);
const addressLineOne = addressParts?.[1] ?? site.address;
const addressLineTwo = addressParts?.[2] ?? '';
---

<footer class="site-footer" data-review-chrome>
  {site.map_embed_url && (
    <div class="site-footer__map">
      <iframe
        src={site.map_embed_url}
        title={`Map showing ${site.name} at ${site.address}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  )}
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      {site.logo && <img src={site.logo} alt={site.name} />}
      <h2>Contact Information</h2>
      {site.address && (
        <a class="site-footer__address" href={google?.href || '#'}>
          <span>{addressLineOne}</span>
          {addressLineTwo && <span>{addressLineTwo}</span>}
        </a>
      )}
      {site.phone && <a href={site.phone_href}>{site.phone}</a>}
      {email && <a href={email.href}>{email.label}</a>}
      <h2>Follow Us</h2>
      <div class="site-footer__social">
        {facebook && <a href={facebook.href} target={facebook.target || undefined} aria-label="Facebook">f</a>}
        {google && <a href={google.href} target={google.target || undefined} aria-label="Google business profile">G</a>}
      </div>
    </div>
    <div class="site-footer__form" role="form" aria-label="Contact form preview">
      <label>Name:<input type="text" readonly /></label>
      <label>Email:<input type="email" readonly /></label>
      <label>Comment:<textarea rows="4" readonly></textarea></label>
      <label>Please enter the text you see:</label>
      <div class="site-footer__captcha" role="img" aria-label="Verification image preview">
        <img src="/assets/6c910a9ef18a_www.jeffreycarldmd.com_sys_images_subchk_65971743.png" alt="" />
        <img src="/assets/71dac83fa275_www.jeffreycarldmd.com_sys_images_subchk_81877479.png" alt="" />
        <img src="/assets/37fee65e1ca8_www.jeffreycarldmd.com_sys_images_subchk_41161474.png" alt="" />
      </div>
      <input type="text" readonly aria-label="Verification response" />
      <button type="button" disabled>Submit</button>
    </div>
  </div>
  <div class="site-footer__copyright">
    <p>{copyrightLine}</p>
    <div class="site-footer__related">
      <span>{page.title}</span>
      <span>{page.meta_description}</span>
      <span>{site.name}, {site.address} · {site.phone} · jeffreycarldmd.com</span>
    </div>
  </div>
</footer>
