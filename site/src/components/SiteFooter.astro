---
import type { SiteRecord } from '../lib/contracts';

interface Props {
  site: SiteRecord;
}

const { site } = Astro.props;
---

<footer class="site-footer" data-review-chrome>
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      {site.logo && <img src={site.logo} alt={site.name} />}
      <p class="site-footer__name">{site.name}</p>
      {site.address && <p>{site.address}</p>}
      {site.phone && <a href={site.phone_href}>{site.phone}</a>}
    </div>
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {site.navigation.map((item) => (
          <li><a href={item.href || '#'} target={item.target || undefined}>{item.label || item.href}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-footer__review">
      <strong>Noindex review build</strong>
      <span>Forms and production integrations are disabled.</span>
    </div>
  </div>
</footer>
