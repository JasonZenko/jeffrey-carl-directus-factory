  color: #1e2031;
}

/*DROPDOWN DIVIDER*/
.TPnavbar > ul[id^="NB"] > li > ul[id$="sb"] > li > a {
  border-bottom: 1px solid #857D82;
}

/*DEFAULT MENU UNDERLINE  HOVER*/
